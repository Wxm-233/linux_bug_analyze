{
  "schema": "n25_contract_candidates_v1",
  "document_format": {
    "id": "D01",
    "profile": "old_s390 or old_x86",
    "kind": "configured_function or selected_config_facts",
    "function": "function name or null",
    "path": "original source path",
    "text": "exact region or disclosed selected config lines",
    "text_sha256": "sha256(text.encode('utf-8'))",
    "configuration_sha256": "actual configuration file digest",
    "source_binding": "original artifact path, digest and JSON pointer"
  },
  "evidence": {"document": "D01", "start_line": 1, "end_line": 3},
  "output": {
    "schema": "n25_contract_candidates_v1",
    "requirements": [{"id": "R1", "statement": "candidate common-use requirement", "basis": "consumer_precondition_inference or external_norm_needed or hypothesis", "applicability": ["explicit condition"], "evidence": [], "unproved": []}],
    "architecture_paths": [{"profile": "old_s390 or old_x86", "requirement_id": "R1", "provider_object": "source expression and role", "eligibility": "candidate preparation domain", "deadline": "candidate deadline", "assessment": "conditional_mismatch or conditional_satisfaction or insufficient", "evidence": [], "unproved": []}],
    "local_checks": [{"id": "L1", "kind": "lexical_call_order", "profile": "old_s390 or old_x86", "document": "D01", "function": "function name", "first": {"callee": "identifier", "line": 1}, "second": {"callee": "identifier", "line": 2}, "expected": "before or after", "evidence": []}],
    "recommended_checks": [{"id": "T1", "requirement_id": "R1", "predicate": "condition to check", "placement": "actual use, not merely pointer retrieval", "evidence": [], "facts_needed": [], "status": "candidate or insufficient"}],
    "limits": []
  },
  "bounds": {"requirements": 3, "local_checks": 6, "maximum_evidence_span_lines": 24},
  "notes": "Model must output one JSON object, no external tools. Evidence line numbers are local lines of numbered packet documents, not historical C lines. Optional column is the 1-based column in that exact packet line. Unknowns are preserved; no retry for malformed output."
}
