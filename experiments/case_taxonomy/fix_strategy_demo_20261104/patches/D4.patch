+/*
+ * Test, and clear if @mkold, the accessed bit of every leaf PTE that maps
+ * [@start, @end); the range need not be exactly one page or block.
+ */
+bool kvm_riscv_gstage_test_young_range(struct kvm_gstage *gstage, gpa_t start, gpa_t end,
+				       bool mkold)
+{
+	int ret;
+	pte_t *ptep;
+	u32 ptep_level;
+	bool found_leaf;
+	gpa_t addr = start;
+	unsigned long page_size;
+	bool young = false;
+
+	while (addr < end) {
+		found_leaf = kvm_riscv_gstage_get_leaf(gstage, addr, &ptep, &ptep_level);
+		ret = gstage_level_to_page_size(gstage, ptep_level, &page_size);
+		if (ret)
+			break;
+
+		if (found_leaf) {
+			if (mkold)
+				young |= ptep_test_and_clear_young(NULL, 0, ptep);
+			else
+				young |= pte_young(ptep_get(ptep));
+		}
+		addr = ALIGN(addr + 1, page_size);
+	}
+
+	return young;
+}
