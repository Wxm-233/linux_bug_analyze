    {
      "declarations": [
        {
          "symbol": "I3C",
          "kind": "menuconfig",
          "declaration_quote": {
            "start_line": 3,
            "end_line": 3,
            "text": "menuconfig I3C"
          },
          "item_quote": {
            "start_line": 3,
            "end_line": 20,
            "text": "menuconfig I3C\n\ttristate \"I3C support\"\n\tselect I2C\n\thelp\n\t  I3C is a serial protocol standardized by the MIPI alliance.\n\n\t  It's supposed to be backward compatible with I2C while providing\n\t  support for high speed transfers and native interrupt support\n\t  without the need for extra pins.\n\n\t  The I3C protocol also standardizes the slave device types and is\n\t  mainly designed to communicate with sensors.\n\n\t  If you want I3C support, you should say Y here and also to the\n\t  specific driver for your bus adapter(s) below.\n\n\t  This I3C support can also be built as a module.  If so, the module\n\t  will be called i3c."
          },
          "property_line_quotes": [
            {
              "start_line": 4,
              "end_line": 4,
              "text": "\ttristate \"I3C support\""
            },
            {
