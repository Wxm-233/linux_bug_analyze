obj-$(CONFIG_MIPI_I3C_HCI)		+= mipi-i3c-hci.o
mipi-i3c-hci-y				:= core.o ext_caps.o pio.o dma.o \
					   cmd_v1.o cmd_v2.o \
					   dat_v1.o dct_v1.o

