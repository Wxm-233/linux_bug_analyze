+void *bpf_arch_text_copy(void *dst, void *src, size_t len)
+{
+	int ret;
+
+	if (!len)
+		return dst;
+
+	mutex_lock(&text_mutex);
+	ret = patch_text_nosync(dst, src, len);
+	mutex_unlock(&text_mutex);
+
+	if (ret)
+		return ERR_PTR(ret);
+	return dst;
+}
