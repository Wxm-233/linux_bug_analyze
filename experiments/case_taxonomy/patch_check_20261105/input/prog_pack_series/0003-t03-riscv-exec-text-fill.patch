 }
 NOKPROBE_SYMBOL(patch_text_nosync);
+int patch_text_set_nosync(void *addr, u8 c, size_t len)
+{
+	u8 *buf;
+	int ret;
+
+	if (len == 0)
+		return 0;
+
+	buf = kzalloc(len, GFP_KERNEL);
+	if (!buf)
+		return -ENOMEM;
+
+	memset(buf, c, len);
+	ret = patch_text_nosync(addr, buf, len);
+	kfree(buf);
+	return ret;
+}
+NOKPROBE_SYMBOL(patch_text_set_nosync);
 
