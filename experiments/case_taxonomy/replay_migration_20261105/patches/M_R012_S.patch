+		if (riscv_alt_insn_is_jal(insn)) {
+			if (RV_EXTRACT_RD_REG(insn) == 1)
+				riscv_alternative_fix_jal(alt_ptr + i * sizeof(u32),
+							  insn, patch_offset);
+			continue;
+		}
+
