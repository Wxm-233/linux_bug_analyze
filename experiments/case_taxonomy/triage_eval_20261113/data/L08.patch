    Here is a simple shell script to reproduce:
    
      #!/bin/bash
    
      for ((i=1; i<=1000; i++))
      do
        echo "Under testing $i ..."
        dmesg -c > /dev/null
        ./test_progs -t fentry_attach_stress > /dev/null
        dmesg -t | grep "text_copy_cb: operation failed"
        if [ $? -eq 0 ]; then
          break
        fi
      done
    
