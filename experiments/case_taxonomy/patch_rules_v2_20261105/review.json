   "run": "r3",
   "group": "K3_rv32_text_copy",
   "verdict": "real",
   "location": "arch/riscv/net/bpf_jit_comp64.c:bpf_arch_text_copy / bpf_arch_text_invalidate（RV32 缺失）",
   "issue": "bpf_arch_text_copy、bpf_arch_text_invalidate 只在 bpf_jit_comp64.c 实现，RV32 没有；共用的 bpf_jit_core.c 已改成 pack 流程"
  },
