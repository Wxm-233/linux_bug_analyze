{
 "labels": [
  {
   "hook": "do_page_fault",
   "step": "user_mode",
   "class": "b",
   "reason": "RISC-V的do_page_fault结构不同，user_mode在其调用的处理函数里（只展开一层同文件函数的假标记）"
  },
  {
   "hook": "copy_thread",
   "step": "task_thread_info",
   "class": "b",
   "reason": "RISC-V的thread_info放在task_struct中，写法不同"
  },
  {
   "hook": "kvm_arch_destroy_vm",
   "step": "mutex_unlock",
   "class": "b",
   "reason": "其他架构销毁时要处理各自中断控制器等需加锁的状态，RISC-V的实现不涉及"
  },
  {
   "hook": "arch_bpf_trampoline_size",
   "step": "kcalloc",
   "class": "b",
   "reason": "实现细节差异"
  },
  {
   "hook": "machine_kexec",
   "step": "local_irq_disable",
   "class": "b",
   "reason": "RISC-V在汇编重定位代码kexec_relocate.S开头用csrw CSR_SIE, zero关中断"
  },
  {
   "hook": "arch_atomic64_dec_if_positive",
   "step": "smp_mb",
   "class": "b",
   "reason": "RISC-V用带aq/rl的LR/SC指令保证顺序，不需要单独的smp_mb"
  },
  {
   "hook": "compat_arch_ptrace",
   "step": "arch_ptrace",
   "class": "b",
   "reason": "实现细节差异"
  },
  {
   "hook": "crash_smp_send_stop",
   "step": "smp_send_stop",
   "class": "b",
   "reason": "RISC-V用自己的IPI实现崩溃时停止其他CPU"
  },
  {
   "hook": "kvm_arch_vcpu_ioctl_set_regs",
   "step": "vcpu_load",
   "class": "b",
   "reason": "RISC-V不支持该接口（返回-EINVAL，改用ONE_REG），无需加载vcpu"
  },
  {
   "hook": "compat_arch_ptrace",
   "step": "copy_regset_to_user",
   "class": "b",
   "reason": "实现细节差异"
  },
  {
   "hook": "tick_broadcast",
   "step": "for_each_cpu",
   "class": "b",
   "reason": "RISC-V直接按掩码发IPI，不逐个CPU循环"
  },
  {
   "hook": "arch_uprobe_exception_notify",
   "step": "uprobe_post_sstep_notifier",
   "class": "b",
   "reason": "RISC-V在陷入处理里直接处理单步，通知函数不需要调用"
  },
  {
   "hook": "arch_prepare_bpf_trampoline",
   "step": "ERR_PTR",
   "class": "b",
   "reason": "实现细节差异"
  },
  {
   "hook": "pte_clear",
   "step": "pte_val",
   "class": "b",
   "reason": "表项表示与写法差异"
  },
  {
   "hook": "ptep_set_access_flags",
   "step": "pte_val",
   "class": "b",
   "reason": "表项表示与写法差异"
  },
  {
   "hook": "apply_relocate_add",
   "step": "ELF32_R_TYPE",
   "class": "b",
   "reason": "RISC-V 64位用ELF64重定位宏"
  },
  {
   "hook": "do_page_fault",
   "step": "faulthandler_disabled",
   "class": "b",
   "reason": "RISC-V在handle_page_fault中检查，只展开一层的假标记"
  },
  {
   "hook": "compat_arch_ptrace",
   "step": "put_user",
   "class": "b",
   "reason": "实现细节差异"
  },
  {
   "hook": "arch_crash_save_vmcoreinfo",
   "step": "VMCOREINFO_CONFIG",
   "class": "c",
   "reason": "其他架构多导出若干CONFIG给崩溃分析工具，RISC-V导出VA_BITS等；是否影响crash工具解析需另查"
  },
  {
   "hook": "pmd_populate_kernel",
   "step": "__pa",
   "class": "b",
   "reason": "RISC-V用页框号写表项，写法不同"
  }
 ]
}
